{
  "name": "kurisu-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "npm run content:check && next dev",
    "build": "npm run content:check && next build && npm run check:public-output",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run content:check && next typegen && tsc --noEmit",
    "content:check": "node --import tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:public-output": "node --import tsx scripts/check-public-output.ts",
    "assets:build": "node scripts/build-brand-assets.mjs",
    "test:harness": "vite --config tests/harness/vite.config.ts",
    "qa:capture": "node --import tsx scripts/capture-qa.ts",
    "format": "prettier --write app components lib scripts tests styles authoring README.md next.config.ts postcss.config.mjs eslint.config.mjs vitest.config.ts playwright.config.ts package.json tsconfig.json",
    "format:check": "prettier --check app components lib scripts tests styles authoring README.md next.config.ts postcss.config.mjs eslint.config.mjs vitest.config.ts playwright.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "github-slugger": "2.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
